# ===== Claude API (必須) =====
ANTHROPIC_API_KEY=sk-ant-...

# ===== モデル設定 =====
# 戦略系は Opus、制作系は Sonnet を推奨（コスト最適化）
MODEL_STRATEGIC=claude-opus-4-7
MODEL_PRODUCTION=claude-sonnet-4-6
MODEL_OPERATIONAL=claude-haiku-4-5

# ===== 翻訳 =====
DEEPL_API_KEY=

# ===== 画像生成 =====
OPENAI_API_KEY=

# ===== プラットフォーム =====
GUMROAD_ACCESS_TOKEN=
MEDIUM_INTEGRATION_TOKEN=
SUBSTACK_SESSION_COOKIE=

# ===== SNS =====
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
THREADS_ACCESS_TOKEN=

# ===== データベース =====
DATABASE_URL="file:./enso.db"

# ===== 通知（CEO向け）=====
CEO_EMAIL=
CEO_SLACK_WEBHOOK=

# ===== ブランディング =====
BRAND_NAME="Enso Letters"
BRAND_DOMAIN="ensoletters.com"
PERSONA_NAME="Haru Koyama"
PERSONA_EMAIL="haru@ensoletters.com"

# ===== 出力先 =====
OUTPUT_DIR=./output
